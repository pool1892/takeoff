# Copy to .env for local configuration. Never commit real credentials.
# The running Hermes instance must use a Takeoff-specific home, for example:
# HERMES_HOME=/absolute/path/to/takeoff/.local/hermes
#
# Supplier credentials may instead live in .local/suppliers/secrets.json.
# The service reads the process environment; it does not automatically load .env.
# AMBIGUOUS_SUPPLIER_API_KEY=       # Setup owner only
# AMBIGUOUS_GENERAL_API_KEY=
# AMBIGUOUS_OVERSTOCK_API_KEY=
# AMBIGUOUS_LOCAL_API_KEY=
# AMBIGUOUS_TRADER_API_KEY=
# TAKEOFF_OPERATOR_TOKEN=          # Generated by the init command
# TAKEOFF_BUYER_TOKEN=             # Distinct, generated by init
#
# Default supplier inference uses the existing Codex account login.
# OPENAI_API_KEY=                  # Optional hosted backend / phone speech API
# Workspace IDs, sender mappings, and model: .local/suppliers/config.json.
# Do not copy private supplier state to the buyer machine.
