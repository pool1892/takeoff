# Copy to .env for local configuration. Never commit real credentials.
# The running Hermes instance must use a Takeoff-specific home, for example:
# HERMES_HOME=/absolute/path/to/takeoff/.local/hermes
#
# Add the exact variable names consumed by the chosen integrations when wiring
# them. Use the NEW buyer Ambiguous workspace and the distinct supplier workspace.
# Keep workspace tokens and model/calling-provider credentials in ignored local
# configuration. Do not copy the remote supplier's private state to this machine.

# Optional live buyer/procurement UI boundary. Omit or set mode=demo for the simulated fixture.
# VITE_PROCUREMENT_MODE=live
# VITE_PROCUREMENT_API_URL=https://buyer.example
# VITE_PROCUREMENT_TASK_ID=task-id
